# BIS Setu Configuration
# Environment: development, staging, production
APP_ENV=development

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# AI / LLM Configuration
# Optional: If not provided, BIS Setu runs in deterministic grounded retrieval mode
GEMINI_API_KEY=

# Persistence & Storage
DATABASE_URL=sqlite:///./database/bis_setu.db
VECTOR_DB_PATH=./data/chroma

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
