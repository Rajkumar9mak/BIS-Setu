  "meta": {
    "title": "Web Request Lifecycle: Redis Cache Miss & PostgreSQL Fallback",
    "subtitle": "Cache-aside pattern: Browser calls API, checks Redis, queries PostgreSQL on cache miss, and warms the cache",
