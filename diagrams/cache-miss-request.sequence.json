        "note": "Full lifecycle from client request to cache miss, database query, and cache population."
      },
      {
        "id": "cache-miss",
        "label": "Cache Miss & Fallback",
        "focus": ["api", "redis", "postgres"],
        "note": "Redis reports a cache miss, prompting the API to fetch source data from PostgreSQL."
      },
      {
        "id": "cache-fill",
        "label": "Cache Fill & Response",
        "focus": ["api", "redis", "browser"],
        "note": "API repopulates Redis cache and returns the payload to the browser."
      }
    ]
  },
